{
  "rewrites": [
    {
      "source": "/shop",
      "destination": "/api/shop"
    },
    {
      "source": "/item/:id",
      "destination": "/api/shop?id=:id"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/shop?sitemap=1"
    },
    {
      "source": "/info",
      "destination": "/info.html"
    },
    {
      "source": "/group",
      "destination": "/group.html"
    },
    {
      "source": "/p/:id",
      "destination": "/api/p?id=:id"
    },
    {
      "source": "/z/:zone",
      "destination": "/api/p?zone=:zone"
    },
    {
      "source": "/c/:cat/:v",
      "destination": "/api/p?cat=:cat&v=:v"
    },
    {
      "source": "/c/:cat",
      "destination": "/api/p?cat=:cat"
    }
  ]
}